# Copilot-Lite 后端本地配置示例
# 复制为 .env 后按需修改；未创建 .env 时使用代码默认值（SQLite，零依赖）

# 运行模式：local / cloud
RUN_MODE=local

# ---- 大模型（必填，P1 起）----
# DeepSeek API Key：https://platform.deepseek.com 创建
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat

# ---- 认证（登录/注册）----
# JWT 签名密钥：生产必须改为强随机值
# 生成：python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-secret-change-me-in-production

# ---- 数据库 ----
# 方案 A：默认 SQLite（零依赖，开箱即用）
# DATABASE_URL=sqlite+aiosqlite:///./copilot.db

# 方案 B：本地 PostgreSQL（推荐，与生产同构）
# 需先创建数据库：createdb copilot
DATABASE_URL=postgresql+asyncpg://postgres:root@localhost:5432/copilot

# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# 调试模式（SQL 回显等）
DEBUG=false
