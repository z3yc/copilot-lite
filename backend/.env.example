# Copilot-Lite 后端本地配置示例
# 复制为 .env 后按需修改；未创建 .env 时使用代码默认值（PostgreSQL@localhost:5432/copilot）

# 运行模式：local / cloud
RUN_MODE=local

# ---- 大模型（可选）----
# 部署无需内置 Key：用户在「个人中心 → 模型设置」各自配置。
# 本 Key 仅作为「超级管理员」账号的兜底；普通注册用户一律自配，禁止白嫖。
# DeepSeek API Key：https://platform.deepseek.com 创建
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat
# 超级管理员：显式配置非空密码才会在启动时创建/提升（role=admin），可用上面的 env Key 兜底
# SUPER_ADMIN_USERNAME=demo
# SUPER_ADMIN_PASSWORD=

# ---- 认证（登录/注册）----
# JWT 签名密钥：生产必须改为强随机值
# 生成：python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-secret-change-me-in-production

# ---- 数据库（只支持 PostgreSQL：本地 / 测试 / 生产同构）----
# 需先创建数据库：createdb copilot（或导入 deploy/sql/init_postgres.sql）
DATABASE_URL=postgresql+asyncpg://postgres:root@localhost:5432/copilot
# 测试库不用手工建（conftest 自动创建 copilot_test）；如需覆盖：
# TEST_DATABASE_URL=postgresql+asyncpg://postgres:root@localhost:5432/copilot_test

# Qdrant 远程模式 API Key（仅云端 http 模式需要；本地模式忽略）
# QDRANT_API_KEY=

# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# 调试模式（SQL 回显等）
DEBUG=false

# ---- 成本控制 / 限流 / 缓存（均有代码默认值，按需取消注释覆盖）----
# LLM_TIMEOUT_SECONDS=60            # 单次模型请求超时（秒）
# LLM_MAX_RETRIES=2                 # SDK 层重试次数
# LLM_MAX_TOKENS=2048               # 单次回复 token 上限
# LLM_MAX_CONCURRENCY=3             # 并发模型请求上限（含流式）
# LLM_DAILY_TOKEN_BUDGET=0          # 每用户每日 token 预算（0=不限）
# LLM_PRICE_INPUT_PER_MTOK=0        # 模型输入单价（每百万 token；0=只统计 token 不计成本）
# LLM_PRICE_OUTPUT_PER_MTOK=0       # 模型输出单价（每百万 token）
# LLM_TRACK_STREAM_USAGE=true       # 流式 token 统计（网关不支持时改 false）
# API_CHAT_RATE_LIMIT=30            # 对话接口窗口内最大请求数
# API_CHAT_WINDOW_SECONDS=60        # 限流窗口（秒）
# API_AI_CREATE_RATE_LIMIT=10       # AI 解析待办接口限流
# HISTORY_WINDOW=20                 # 注入 LLM 的最近消息条数
# HISTORY_MAX_TOKENS=4000           # 滚动历史 token 预算（0=不限）
# EMBED_QUERY_CACHE_SIZE=512        # 查询嵌入缓存条数
# RERANK_CACHE_SIZE=128             # Rerank 结果缓存条数

# ---- 嵌入模型缓存 ----
# EMBEDDING_CACHE_DIR=./data/models # 模型缓存目录（固定持久卷，避免落 %TEMP% 被清理后重下）
# EMBEDDING_PREWARM=true            # 启动时后台预热嵌入模型（首次下载约 50MB）

# ---- Agent 轨迹（可观测）----
# AGENT_TRACE_ENABLED=true         # 轨迹落 Message.extra（关闭则前端不显示轨迹面板）

# ---- Wiki 本地知识库（Obsidian 导入）----
# WIKI_ENABLED=true                 # Wiki 功能开关
# WIKI_STORAGE_ROOT=./data/wiki     # 受管副本根目录
# WIKI_SCAN_INTERVAL_MINUTES=0      # 定时同步间隔（分钟，0=仅手动）
# WIKI_LINK_EXPANSION_ENABLED=true  # 检索时用双链邻居扩展召回
# WIKI_EXPAND_HOPS=1                # 邻居扩展跳数
# WIKI_EXPAND_NEIGHBORS=2           # 链接邻居最多补充的候选块数
# WIKI_GRAPH_MAX_NODES=300          # 图谱接口单次返回节点数上限（超出按度数截断）
# WIKI_MAX_ARCHIVE_BYTES=209715200  # 压缩包上限（200MB）
# WIKI_MAX_EXTRACT_BYTES=524288000  # 解压后总大小上限（500MB）
# WIKI_MAX_FILES=5000               # 单次导入文件数上限
# WIKI_INCLUDE_NON_MD=true          # vault 内 PDF/DOCX/TXT 也索引进 Wiki
# WIKI_EXCLUDE_DIRS=templates,模板     # 扫描排除的目录名（逗号分隔）
# WIKI_ALLOW_LOCAL_PATH=true        # 允许 local 空间用绝对文件夹路径（云端多用户建议 false）

# ---- 管理后台 / 评测作业（ADMIN_PLAN）----
# ADMIN_ENABLED=true                # 管理后台开关（仅管理员可访问；false 时 /admin 一律 404）
# EVAL_JOB_ENABLED=false            # 页面触发评测的后台作业开关（后台任务，测试默认关）
# EVAL_JOB_CONCURRENCY=1            # 评测作业并发上限
# EVAL_JOB_TIMEOUT_SECONDS=600       # 单个评测作业超时（秒）

# ---- 通用后台作业（J1：异步摄取/同步）----
# JOBS_ENABLED=true                 # 作业开关（false=import/sync 内联执行，旧行为）
# JOBS_CONCURRENCY=2                # 后台作业并发上限
# JOBS_TIMEOUT_SECONDS=1800         # 单次尝试超时（秒）
# JOBS_MAX_ATTEMPTS=2               # 单作业最大尝试次数（耗尽置 dead 死信）
