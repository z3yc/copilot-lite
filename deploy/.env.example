# =====================================================
# Copilot-Lite 部署配置模板
# 复制为 deploy/.env 并按环境修改（.env 已被 gitignore 保护）
# =====================================================

# ---- 运行模式 ----
# local : 本地开发（SQLite 或本地 PostgreSQL，create_all 建表）
# cloud : 云端部署（PostgreSQL + Alembic 迁移）
RUN_MODE=cloud

# ---- 大模型（必填）----
# DeepSeek API Key：https://platform.deepseek.com
DEEPSEEK_API_KEY=

# ---- 安全（生产必填！）----
# JWT 签名密钥：强随机值，生成命令：
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
# 云模式使用代码默认值会拒绝启动（安全自检）
SECRET_KEY=

# ---- Agent 引擎 ----
# langgraph（多 Agent 路由，默认）/ handwritten（手写 ReAct，可对比）
AGENT_ENGINE=langgraph

# ---- 数据库 ----
# 云端使用 PostgreSQL（Docker Compose 内置）
DATABASE_URL=postgresql+asyncpg://copilot:copilot@postgres:5432/copilot

# ---- 向量库 ----
# 云端使用 Qdrant 服务（Docker Compose 内置）
QDRANT_URL=http://qdrant:6333
QDRANT_PATH=./qdrant_data

# ---- 缓存（预留）----
REDIS_URL=redis://redis:6379/0

# ---- 知识库检索参数 ----
RAG_TOP_K=5
RAG_RERANK_CANDIDATE_K=10
RAG_RERANK_TOP_N=3
RAG_RERANK_ENABLED=true

# ---- 日志 ----
LOG_LEVEL=INFO
DEBUG=false
