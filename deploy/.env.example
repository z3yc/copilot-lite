# =====================================================
# Copilot-Lite 部署配置模板
# 复制为 deploy/.env 并按环境修改（.env 已被 gitignore 保护）
# =====================================================

# ---- 运行模式 ----
# local : 本地开发（PostgreSQL，create_all 建表）
# cloud : 云端部署（PostgreSQL + Alembic 迁移）
RUN_MODE=cloud

# ---- 大模型（可选）----
# 部署无需内置 Key：用户在前端「个人中心 → 模型设置」各自配置。
# 本 Key 仅作为「超级管理员」账号的兜底；普通注册用户一律自配，禁止白嫖。
# DeepSeek API Key：https://platform.deepseek.com
DEEPSEEK_API_KEY=
# ---- 超级管理员账号（role=admin）----
# 显式配置非空密码后，后端启动时才会自动创建（或把同名账号提升为）超管，
# 默认用户名 demo；未配置密码则不创建该账号。
# 超管是唯一能走环境变量 DEEPSEEK_API_KEY 兜底调用模型的账号（普通用户须自配 Key），
# 并可访问管理后台 /admin（ADMIN_ENABLED=true 时）。
# SUPER_ADMIN_USERNAME=demo
# SUPER_ADMIN_PASSWORD=

# ---- 安全（生产必填！）----
# JWT 签名密钥：强随机值，生成命令：
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
# 云模式使用代码默认值会拒绝启动（安全自检）
SECRET_KEY=

# ---- Agent 引擎 ----
# langgraph（多 Agent 路由，默认）/ handwritten（手写 ReAct，可对比）
AGENT_ENGINE=langgraph
# Agent 轨迹落库开关（可观测：路由 / 节点 / 工具 / 结果 / 耗时）
AGENT_TRACE_ENABLED=true

# ---- 数据库 ----
# 云端使用 PostgreSQL（Docker Compose 内置）
# ⚠️ POSTGRES_PASSWORD 与下方 URL 口令必须一致；缺省 compose 拒绝启动
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+asyncpg://copilot:你的口令@postgres:5432/copilot

# ---- 向量库 ----
# 云端使用 Qdrant 服务（Docker Compose 内置，开启 API Key 认证）
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=
QDRANT_PATH=./qdrant_data

# ---- Redis（预留：多实例部署时限流/预算/缓存切换至此）----
# 口令与 compose 的 REDIS_PASSWORD 一致；URL 用 redis://:口令@ 内嵌形式
REDIS_PASSWORD=
REDIS_URL=redis://:你的口令@redis:6379/0

# ---- 知识库检索参数 ----
RAG_TOP_K=5
RAG_RERANK_CANDIDATE_K=10
RAG_RERANK_TOP_N=3
RAG_RERANK_ENABLED=true

# ---- 成本控制 / 限流 ----
# LLM 调用健壮性（超时秒 / SDK 重试次数 / 单次回复 token 上限）
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_MAX_TOKENS=2048
# 并发上限：同时在飞的模型请求数（含流式，信号量约束）
LLM_MAX_CONCURRENCY=3
# 每用户每日 token 预算（0=不限仅统计；开启后超限返回 429）
LLM_DAILY_TOKEN_BUDGET=0
# 模型单价（每百万 token；0=只统计 token 不计成本）——供用量成本看板
LLM_PRICE_INPUT_PER_MTOK=0
LLM_PRICE_OUTPUT_PER_MTOK=0
# 流式是否统计 token 用量（个别网关不支持 include_usage 时改 false）
LLM_TRACK_STREAM_USAGE=true
# 接口限流（滑动窗口，按用户维度）
API_CHAT_RATE_LIMIT=30
API_CHAT_WINDOW_SECONDS=60
API_AI_CREATE_RATE_LIMIT=10

# ---- 上下文与记忆 ----
# 注入 LLM 的最近对话消息条数（system 上下文不占窗口）
HISTORY_WINDOW=20
# 滚动历史 token 预算（0=不限）：长消息防撑爆上下文与成本
HISTORY_MAX_TOKENS=4000
# 后台摘要压缩 / 记忆提取开关（测试环境关闭）
SUMMARY_COMPRESS_ENABLED=true
MEMORY_EXTRACT_ENABLED=true

# ---- 检索缓存 ----
EMBED_QUERY_CACHE_SIZE=512
RERANK_CACHE_SIZE=128

# ---- 嵌入模型缓存（固定持久卷，避免每次联网重下）----
EMBEDDING_CACHE_DIR=./data/models
EMBEDDING_PREWARM=true

# ---- Wiki 本地知识库（Obsidian 导入）----
WIKI_ENABLED=true
# 受管副本根目录（挂载卷；本地路径导入需在此目录下，zip 导入解压到此）
WIKI_STORAGE_ROOT=./data/wiki
# 定时同步间隔（分钟，0=仅手动触发）
WIKI_SCAN_INTERVAL_MINUTES=0
# 检索时用双链邻居扩展召回（可开关对比）
WIKI_LINK_EXPANSION_ENABLED=true
WIKI_EXPAND_HOPS=1
WIKI_EXPAND_NEIGHBORS=2
WIKI_GRAPH_MAX_NODES=300
# 导入安全上限（防 zip 炸弹）
WIKI_MAX_ARCHIVE_BYTES=209715200
WIKI_MAX_EXTRACT_BYTES=524288000
WIKI_MAX_FILES=5000
# vault 内非 Markdown（PDF/DOCX/TXT）也索引进 Wiki 空间
WIKI_INCLUDE_NON_MD=true
# 扫描排除的目录名（逗号分隔；默认排除模板目录）
WIKI_EXCLUDE_DIRS=templates,模板,.templates,_templates
# 允许 local 空间使用绝对文件夹路径（云端多用户部署建议 false）
WIKI_ALLOW_LOCAL_PATH=true

# ---- 管理后台 / 评测作业（ADMIN_PLAN）----
# 管理后台开关（仅管理员可访问；false 时 /admin 一律 404）
ADMIN_ENABLED=true
# 页面触发评测的后台作业开关（后台任务；默认关闭，开启后才执行评测）
EVAL_JOB_ENABLED=false
# 评测作业并发上限（跑真实嵌入 / LLM judge，限并发防打爆）
EVAL_JOB_CONCURRENCY=1
# 单个评测作业超时（秒；超时置 failed，防后台无限期挂起）
EVAL_JOB_TIMEOUT_SECONDS=600

# ---- 通用后台作业（J1：异步摄取/同步）----
# 作业开关（true：import/sync 立即返回 job_id，后台执行，前端轮询进度；
# false：内联执行，保留旧行为，便于演示/排障）
JOBS_ENABLED=true
# 后台作业并发上限（摄取/同步跑真实嵌入，限并发防打爆）
JOBS_CONCURRENCY=2
# 单次尝试超时（秒；超时按失败处理并进入重试计数）
JOBS_TIMEOUT_SECONDS=1800
# 单作业最大尝试次数（耗尽后置 dead 死信，等待人工重试）
JOBS_MAX_ATTEMPTS=2

# ---- MCP 外部能力接入（批次 P/R4：基金行情，设计 §15）----
# 总开关（false：领域工具如实提示「未配置行情源」，不报错、不炸主链路）
MCP_ENABLED=false
# server 注册表（JSON 数组；管理员级白名单，只允许此处声明的 server）
# command 留空 = 用当前解释器（推荐，避开 Windows python 商店桩）；cwd 缺省为 backend 根
# env 里的密钥仅供拉起子进程使用：**不入库、不进日志**（AGENTS §6.1/§6.8）
# 接入新 MCP：加一条配置 + 在领域侧注册适配器，client 无需改动（见 app/mcp/__init__.py）
MCP_SERVERS=[{"name":"fund-quotes","command":"","args":["-m","app.mcp_servers.fund_quotes"],"tool":"get_fund_nav","adapter":"fund_nav_v1"}]
# 单次 MCP 调用超时（秒）
MCP_CALL_TIMEOUT_SECONDS=10
# 行情缓存窗口（分钟）：窗口内同代码复用缓存，不重复调用 MCP
FUND_QUOTE_CACHE_MINUTES=60

# ---- CORS（云端按部署域名配置，JSON 数组；默认放行本地 5173）----
# CORS_ORIGINS=["https://你的域名"]

# ---- 日志 ----
LOG_LEVEL=INFO
DEBUG=false
